rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins authorized to read/manage CRM data. Edit this list to grant access.
    // (Removed luckysitara@gmail.com — a contractor's personal Gmail that was
    //  hardcoded here since the file's creation; it should never have had access.)
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['help.remodely@gmail.com', 'joshb@surprisegranite.com'];
    }

    // Leads — anyone can submit (grader/contact forms); only admins read/manage.
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Tenant config for the embeddable tools. Public read is required: the embed
    // runs on a customer's own domain with no credentials and must resolve its own
    // branding and subscription state. Nothing secret goes in these documents —
    // notify addresses live in tenant_private, which no client can read.
    match /tenants/{slug} {
      allow read: if true;
      allow write: if false;          // service account bypasses rules
    }

    // Delivery config: shop inboxes. Service account only.
    match /tenant_private/{slug} {
      allow read, write: if false;
    }

    // Clients — admins only.
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    // Admin list collection — admins only.
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Settings (includes the settings/admins doc the admin page reads to gate
    // access). This rule was MISSING before — its absence made the page's
    // settings read fail, which silently denied everyone the dashboard.
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    // Grader results — public create/read (anonymous report flow).
    match /graderReports/{reportId} {
      allow create: if true;
      allow read: if true;
    }
  }
}
